# ============================================================
# Trippin — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://trippin:trippin_secret@localhost:5432/trippin_db"

# ── NextAuth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# ── GitHub OAuth ─────────────────────────────────────────────
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# ── Mapbox ───────────────────────────────────────────────────
# Get a free token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN="REPLACE_WITH_MAPBOX_TOKEN"

# ── Media Storage ────────────────────────────────────────────
# Local dev: a folder in your project (git-ignored)
# Docker:    set to /app/uploads (mapped to a named volume)
UPLOAD_DIR="./uploads"
